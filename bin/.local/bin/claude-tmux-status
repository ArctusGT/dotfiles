#!/usr/bin/env bash
# Claude Code hook: claude-tmux-status wait|clear, hook JSON on stdin.
# `wait` (Notification, Stop) marks Claude's tmux window with @claude_wait and
# rings its bell, plus every client running inside another tmux (an ssh-tmux
# relay); `clear` (UserPromptSubmit) unmarks it. Marked windows show in every
# session's status bar (see .tmux.conf.local). Reads $TMUX_PANE, which Claude
# inherits from its pane; does nothing outside tmux.
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
cat >/dev/null # drain hook JSON on stdin
[[ -n $TMUX_PANE ]] || exit 0
case $1 in
  wait)
    # no need to flag the window you're already looking at. Over ssh an
    # attached session doesn't mean you're looking, so still ring the bell:
    # it passes through ssh and the local tmux marks the ssh window.
    viewing=$(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}')
    [[ $viewing == 1 && -z $SSH_CONNECTION ]] && exit 0
    [[ $viewing == 1 ]] || tmux set -w -t "$TMUX_PANE" @claude_wait 1
    tty=$(tmux display -p -t "$TMUX_PANE" '#{pane_tty}') && printf '\a' >"$tty"
    # tmux forwards a pane's bell only to clients on that pane's session, and
    # the Mac's ssh-tmux client may be on another one. That client runs inside
    # the Mac's tmux, so its terminal type is tmux*: ring every such client.
    for relay_tty in $(tmux list-clients -f '#{m:tmux*,#{client_termname}}' -F '#{client_tty}'); do
      printf '\a' >"$relay_tty"
    done
    ;;
  clear) tmux set -wu -t "$TMUX_PANE" @claude_wait ;;
esac
exit 0
