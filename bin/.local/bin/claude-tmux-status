#!/usr/bin/env bash
# Claude Code hook: claude-tmux-status wait|clear, hook JSON on stdin.
# `wait` (Notification, Stop) marks Claude's tmux window with @claude_wait and
# rings its bell, plus the ssh-tmux relay client the server records as
# @relay_client; `clear` (UserPromptSubmit) unmarks it. Marked windows show in
# the status bar of every session that draws one (@claude_wait_marker in
# tmux-sidebar/.tmux-sidebar.conf).
# Reads $TMUX_PANE, which Claude inherits from its pane, and $SSH_CONNECTION.
# A session with no pane, run by a `claude daemon`, still rings the relay on
# `wait`, so the Mac marks its ssh window; its `tmux` is whichever the hook's
# PATH finds, reaching the default server.
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
cat >/dev/null # drain hook JSON on stdin

# tmux forwards a pane's bell only to clients on that pane's session, and the
# Mac's ssh-tmux client may be on another one: ring it directly. ssh-tmux
# records it as @relay_client; on a host with none, nothing rings. Matching
# clients by a tmux* terminal type instead would also ring the Mac's own
# tmux-frame client.
ring_relays() {
  local relay tty
  relay=$(tmux show -gv @relay_client 2>/dev/null) || return 0
  tty=$(tmux display -p -c "$relay" '#{client_tty}' 2>/dev/null) && printf '\a' >"$tty"
}

if [[ -z $TMUX_PANE ]]; then
  [[ $1 == wait ]] && ring_relays
  exit 0
fi
case $1 in
  wait)
    # no need to flag the window you're already looking at. Over ssh an
    # attached session doesn't mean you're looking, so still ring the bell:
    # it passes through ssh and the local tmux marks the ssh window.
    viewing=$(tmux display -p -t "$TMUX_PANE" '#{&&:#{window_active},#{session_attached}}')
    [[ $viewing == 1 && -z $SSH_CONNECTION ]] && exit 0
    [[ $viewing == 1 ]] || tmux set -w -t "$TMUX_PANE" @claude_wait 1
    tty=$(tmux display -p -t "$TMUX_PANE" '#{pane_tty}') && printf '\a' >"$tty"
    ring_relays
    ;;
  clear) tmux set -wu -t "$TMUX_PANE" @claude_wait ;;
esac
exit 0
