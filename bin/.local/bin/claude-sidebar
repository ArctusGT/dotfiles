#!/usr/bin/env bash
# claude-sidebar [rows|pick N|kick|edge|jump|attach]: list every Claude session on this host and
# on each host the sesh config reaches through `ssh-tmux`, grouped by host, and
# jump to one. With no argument, runs the list in fzf; Enter or a click jumps.
# Two background loops keep the list in a cache: one gathers it every second,
# or at once on a kick, so fzf never waits on a host; the other,
# `claude-sidebar-loop`, built from the repo's crate of that name, renders its
# frames and shows them in fzf, 8 a second while a Clawd moves. `tmux-frame`
# runs the sidebar as the frame's left pane: a jump moves the frame's right
# pane, and fzf's cursor follows the session on show there however it changed.
# Run elsewhere, a jump moves the usual tmux's most recent client.
# Keeps its cache in ${TMPDIR:-/tmp}/claude-sidebar, and the background loops'
# errors in ${TMPDIR:-/tmp}/claude-sidebar.log rather than over the list.
#   rows              print the list once, as fzf reads it
#   pick N            jump to the entry numbered N (the frame's M-1..9), as
#                     the running sidebar shows it
#   kick              have a running sidebar rebuild now (tmux hooks call it
#                     when a client changes session or window)
#   edge SIDE TTY PANE [HOST]
#                     cross the usual tmux's window edge SIDE (left, up or
#                     down) from PANE, for the client on TTY: left focuses the
#                     sidebar, up and down show the previous or next entry.
#                     Only from the frame's right pane. With HOST, PANE is an
#                     ssh-tmux window's and HOST's active pane decides: not at
#                     that edge, the key goes on to HOST's tmux
#   jump HOST PANE SESSION [ID]
#                     focus PANE on HOST (empty HOST = this one); a remote pane
#                     is shown through the Mac's SESSION, its ssh-tmux relay.
#                     With no PANE, opens background Claude session ID first
#   attach ID         print the pane showing background Claude session ID on
#                     this host, opening it with `claude attach`, tagged
#                     @claude_attach, if none does: in a new window of the tmux
#                     session named for its repo, created if absent
# CLAUDE_CTX_WARN     context percentage an entry's context line turns red at
#                     (default 50)
# SESH_CONFIG         sesh config the hosts come from
#                     (default ~/.config/sesh/sesh.toml)
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
sesh_config=${SESH_CONFIG:-$HOME/.config/sesh/sesh.toml}
# ServerAlive drops a master connection to a host gone quiet within 4s, where
# ConnectTimeout does not reach a call made over an existing master
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2
  -o ServerAliveCountMax=2 -o ControlPath=/tmp/claude-sidebar-%C)
cache=${TMPDIR:-/tmp}/claude-sidebar
# a host's one client from the Mac, which runs inside the Mac's tmux (tmux*
# term), as a command run on the host; add -F
relay_client="tmux list-clients -f '#{m:tmux*,#{client_termname}}'"

# the usual tmux server, from inside the frame's server too
work() { env -u TMUX -u TMUX_PANE tmux "$@"; }

# "<pane id> <pane tty>" of the frame's right pane; empty outside the frame
frame_main() {
  tmux list-panes -s -F '#{@frame_main} #{pane_id} #{pane_tty}' 2>/dev/null | awk '$1 == 1 {print $2, $3; exit}'
}

# "<session name>\t<ssh host>" for each sesh entry started by ssh-tmux
remote_hosts() {
  [[ -f $sesh_config ]] || return 0
  awk '/^\[\[session\]\]/ {name=""}
       /^name *=/ {name=$0; sub(/^name *= *"/, "", name); sub(/".*/, "", name)}
       /^startup_command *=.*ssh-tmux / {
         host=$0; sub(/.*ssh-tmux +/, "", host); sub(/[ "].*/, "", host)
         print name "\t" host }' "$sesh_config"
}

# claude-sessions' lines on stdin, tagged with where they came from, sessions
# with a pane first, and desktop app sessions left out unless one has a pane; a
# header line before them, so every host shows even with no sessions. The
# header carries the host's pane on show in the frame, if any
tag() { # $1 label, $2 ssh host, $3 relay session, $4 "unreachable" or empty, $5 pane on show
  jq -nc --arg label "$1" --arg down "$4" --arg current "$5" \
    '{header: true, $label, down: ($down != ""), $current}'
  [[ -n $4 ]] || jq -sc --arg host "$2" --arg relay "$3" \
    'map(select(.entrypoint != "claude-desktop" or .tmux_pane != null))
     | sort_by(.tmux_pane == null)[] + {$host, $relay}'
}

# every host's tagged lines, local first
collect() {
  local tmp; tmp=$(mktemp -d) || return
  # what the frame's right pane shows: a local pane, or a host's relay window
  local main shown="" relay_host=""
  main=$(frame_main)
  [[ -n $main ]] && read -r shown relay_host < <(work display -p -c "${main#* }" '#{pane_id} #{@ssh_tmux}')
  # hosts in parallel, so an unreachable one costs one ConnectTimeout, not more
  { claude-sessions | tag local "" "" "" "$([[ -z $relay_host ]] && echo "$shown")" >"$tmp/0"; } &
  local i=0 name host
  while IFS=$'\t' read -r name host; do
    i=$((i + 1))
    {
      # one master connection per host, so a refresh is not a login. After
      # the sessions, \036 and the pane the Mac's client there is on
      if out=$(ssh "${ssh_opts[@]}" -o ControlMaster=auto -o ControlPersist=60 "$host" \
        "claude-sessions; printf '\036'; $relay_client -F '#{pane_id}' | head -1" \
        2>/dev/null); then
        local remote_shown=""
        [[ $relay_host == "$host" ]] && remote_shown=${out#*$'\036'}
        tag "$name" "$host" "$name" "" "${remote_shown//$'\n'/}" <<<"${out%%$'\036'*}"
      else
        tag "$name" "$host" "$name" unreachable "" </dev/null
      fi >"$tmp/$i"
    } &
  done < <(remote_hosts)
  wait
  cat "$tmp"/* | grep -v '^$'
  rm -rf "$tmp"
}

# the tmux session for directory $1: named for the repo holding it, so a
# subdirectory and every linked worktree of a repo share one, and for $1 itself
# outside a repo. Either way the name sesh gives the repo's root, or $1, so on
# the Mac a repo's sesh session: the basename, with `.` and `:`, which a tmux
# target cannot hold, turned to `_`
tmux_session_for() { # $1 directory
  local dir=$1 common_git_dir top name
  common_git_dir=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  case $common_git_dir in
    # the main checkout's .git, which its worktrees share
    */.git) dir=${common_git_dir%/.git} ;;
    # a submodule's, under its superproject's .git/modules, whose parent is
    # no checkout: name it for its own top level instead
    ?*) top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && dir=$top ;;
  esac
  name=$(basename "$dir")
  echo "${name//[.:]/_}"
}

# the pane showing background session $1 on this host. If none does, opens one
# in a new window of the tmux session named for the session's repo, creating
# that tmux session detached if absent
attach() { # $1 session id
  local row pane cwd job tmux_session open
  # claude-sessions now, not the cached rows, so a second select before the
  # next refresh finds the first window by its tag, and a tagged pane since
  # switched to another session is not reused
  row=$(claude-sessions | jq -c --arg s "$1" 'select(.session_id == $s)')
  pane=$(jq -r '.tmux_pane // empty' <<<"$row")
  if [[ -z $pane ]]; then
    cwd=$(jq -r '.cwd // empty' <<<"$row")
    [[ -n $cwd ]] || return 1
    # `claude attach` takes the daemon's job id, which need not be the session's
    job=$(claude agents --json | jq -r --arg s "$1" '.[] | select(.sessionId == $s) | .id // empty')
    [[ -n $job ]] || return 1
    tmux_session=$(tmux_session_for "$cwd")
    # tagged in the same call, so a select racing this one finds the window.
    # The new window, or session, becomes current, which `set` without -t
    # relies on. The pane, not the window, so a split beside it does not share
    # the tag
    # `=` matches the name exactly, where a bare target also takes a prefix
    if work has-session -t "=$tmux_session" 2>/dev/null; then
      open=(new-window -t "=$tmux_session:")
    else
      open=(new-session -d -s "$tmux_session")
    fi
    pane=$(work "${open[@]}" -P -F '#{pane_id}' -c "$cwd" "claude attach $job" \; \
      set -p @claude_attach "$1") || return 1
  fi
  echo "$pane"
}

# a jump moving the right pane's client: $cache/moving.<pid> before it moves;
# once it has (on a host, once its ssh is back), a new value in
# $cache/jumped, written whole, and only then the mark goes. A gather keeps
# the value it began with, and claude-sidebar-loop takes the cursor to the
# session on show only if that value still stands and no jump is moving,
# however slow the host
moving() { [[ -d $cache ]] && : >"$cache/moving.$$"; return 0; }
moved() {
  [[ -d $cache ]] || return 0
  echo "$EPOCHREALTIME-$$" >"$cache/jumped.$$" && mv "$cache/jumped.$$" "$cache/jumped"
  rm -f "$cache/moving.$$"
}

jump() { # $1 ssh host, $2 pane, $3 relay session, $4 session id
  local host=$1 pane=$2 relay=$3 id=$4
  [[ -n $id ]] || return 0 # a header
  # inside the frame, move the client in its right pane and focus that pane
  local main client=()
  main=$(frame_main)
  [[ -n $main ]] && client=(-c "${main#* }")
  if [[ -z $host ]]; then
    [[ -n $pane ]] || pane=$(attach "$id") || return
    moving
    work switch-client "${client[@]}" -t "$pane" \; select-window -t "$pane" \; select-pane -t "$pane"
    moved
  else
    # the Mac window holding this host's relay, tagged by ssh-tmux
    local window
    window=$(work list-windows -a -F '#{window_id} #{@ssh_tmux}' | awk -v h="$host" '$2 == h {print $1; exit}')
    [[ -n $window ]] || { tmux display-message "open $relay first (prefix f)"; return; }
    moving
    work switch-client "${client[@]}" -t "$window" \; select-window -t "$window"
    # the host's client from the Mac moves, in the background, so a slow link
    # does not hold up the caller, which for a click is fzf itself. The kick
    # waits for it, or the gather it brings could see the host's old session
    # on show and take the cursor back
    {
      ssh "${ssh_opts[@]}" "$host" "
      client=\$($relay_client -F '#{client_name}' | head -1)
      [ -n \"\$client\" ] || exit
      pane='$pane'
      [ -n \"\$pane\" ] || pane=\$(claude-sidebar attach '$id') || exit
      tmux switch-client -c \"\$client\" -t \"\$pane\" \\; select-window -t \"\$pane\" \\; select-pane -t \"\$pane\""
      moved
      kick
    } </dev/null >/dev/null 2>&1 &
  fi
  [[ -n $main ]] && tmux select-pane -t "${main%% *}"
  # rebuild now, so the list shows the move; a host's jump kicks above, once
  # its client there has moved
  [[ -n $host ]] || kick
}

# wake a running sidebar's gathering through the fifo $cache/kick, opened
# read and write, so a sidebar gone and its fifo left behind cannot hang a
# tmux hook on the open
kick() {
  local fd
  [[ -p $cache/kick ]] || return 0
  exec {fd}<>"$cache/kick"
  echo >&"$fd"
  exec {fd}>&-
}

# the usual tmux's Cmd+Left/Up/Down bindings call this at a window's edge, and
# always in an ssh-tmux window, whose edges are the host's
edge() { # $1 left|up|down, $2 client tty, $3 pane, $4 ssh host
  local side=$1 tty=$2 pane=$3 host=$4 key pane_at
  case $side in
    left) key=C-M-Left pane_at=pane_at_left ;;
    up) key=C-M-Up pane_at=pane_at_top ;;
    down) key=C-M-Down pane_at=pane_at_bottom ;;
    *) return 2 ;;
  esac
  # no sidebar to cross into: the host's key is still the host's
  if ! from_frame "$tty"; then
    [[ -z $host ]] || work send-keys -t "$pane" "$key"
    return 0
  fi
  # the pane at the edge, then the rest of its window's; in an ssh-tmux
  # window, the host's active pane and its window
  local panes
  if [[ -n $host ]]; then
    local at_edge
    read -r at_edge panes < <(ssh "${ssh_opts[@]}" "$host" "$relay_client -F '#{$pane_at} #{pane_id} #{window_id}' | head -1 |
      while read -r at p w; do echo \$at \$p \$(tmux list-panes -t \$w -F '#{pane_id}'); done" 2>/dev/null)
    # the host's pane can still move that way, or the host did not answer
    [[ $at_edge == 1 ]] || { work send-keys -t "$pane" "$key"; return 0; }
  else
    panes="$pane $(work list-panes -t "$pane" -F '#{pane_id}' | tr '\n' ' ')"
  fi
  case $side in
    left) tmux select-pane -t '{left}' ;; # the sidebar, as the frame's M-s finds it
    up) step "$host" "$panes" -1 ;;
    down) step "$host" "$panes" 1 ;;
  esac
}

# whether the usual tmux's client on tty $1 is the frame's right pane. Points
# TMUX at the frame's server first, so frame_main, jump and pick reach the
# frame as the tmux they run in, as they do from fzf
from_frame() {
  local socket main
  socket=$(tmux -L frame display -p '#{socket_path}' 2>/dev/null) || return
  export TMUX=$socket,0,0
  main=$(frame_main)
  [[ -n $main && ${main#* } == "$1" ]]
}

# pick the entry $3 numbers away from the first of panes $2 (space-separated)
# that is a numbered entry on ssh host $1 (empty for this one), so a shell
# under Claude steps from its window's entry; nothing past either end, or when
# no pane is one. The panes, not the rows' entry on show, which lags any change
# by up to a refresh, so a held key walks the list
step() {
  local entry
  entry=$(perl -0ne 'BEGIN { ($h, $ps) = splice @ARGV, 0, 2; @p = split " ", $ps }
    chomp; @f = split /\t/, $_, -1;
    $n{$f[1]} = $f[4] if $f[0] eq $h && $f[4] ne "";
    END { for (@p) { if (exists $n{$_}) { print $n{$_}; last } } }' "$1" "$2" "$cache/rows.0")
  [[ -n $entry ]] && pick $((entry + $3))
  return 0
}

# the position in fzf's list (from 1) of the first row whose field $1 is $2
position() {
  perl -0ne 'BEGIN { ($f, $v) = splice @ARGV, 0, 2 }
    $i++; chomp; if ((split /\t/, $_, -1)[$f - 1] eq $v) { print $i; exit }' "$1" "$2" "$cache/rows.0"
}

# run fzf actions in the running sidebar
fzf_do() { curl -sf --unix-socket "$cache/fzf.sock" -X POST http://localhost -d "$1"; }

# the tagged lines `pick` reads, collected from every host and replaced whole,
# so a reader never sees half of them
gather() { collect >"$cache/tagged.new" && mv "$cache/tagged.new" "$cache/tagged"; }

# empty fd $1 of the lines waiting on it; succeeds if there were any
drained() {
  local any=1
  while read -r -t 0 -u "$1" && read -r -u "$1"; do any=0; done
  return "$any"
}

# gather every second, or as soon as a kick comes through the fifo
# $cache/kick, then wake claude-sidebar-loop to render the gather with a line
# to the fifo $cache/gathered: the value $cache/jumped had when the gather
# began, then "moved" when a kick came during it, so what it saw on show in
# the frame may already be gone, and gather again at once
gathering() {
  local kicks since
  exec {kicks}<>"$cache/kick"
  while :; do
    drained "$kicks" # the kicks this gather answers
    read -r since <"$cache/jumped"
    gather
    if drained "$kicks"; then
      echo "$since moved" >"$cache/gathered"
      continue
    fi
    echo "$since" >"$cache/gathered"
    read -r -t 1 -u "$kicks"
  done
}

pick() { # $1 entry number, as the rows number the entries
  (( $1 >= 1 )) || return 0 # jq would count 0 and below from the end
  local host pane relay id
  # the running sidebar's list, so N is the number on screen
  local tagged=$cache/tagged
  [[ -f $tagged ]] || { mkdir -p "$cache"; collect >"$cache/once"; tagged=$cache/once; }
  IFS=$'\x1f' read -r host pane relay id < <(jq -sr --argjson n "$1" '
    [.[] | select((.header | not) and .tmux_pane != null)][$n - 1] // empty
    | [.host, .tmux_pane, .relay, .session_id] | join("\u001f")' "$tagged")
  [[ -n $pane ]] || return 0
  jump "$host" "$pane" "$relay" "$id"
  [[ -S $cache/fzf.sock ]] && fzf_do "pos($(position 5 "$1"))"
}

case $1 in
  rows) collect | claude-sidebar-loop rows ;;
  pick) pick "$2" ;;
  kick) kick ;;
  edge) edge "$2" "$3" "$4" "$5" ;;
  jump) jump "$2" "$3" "$4" "$5" ;;
  attach) attach "$2" ;;
  "")
    mkdir -p "$cache" && rm -f "$cache/gathered" "$cache/kick" "$cache"/moving.* &&
      mkfifo "$cache/gathered" "$cache/kick" && moved && gather &&
      claude-sidebar-loop rows <"$cache/tagged" >"$cache/rows.0"
    # errors to a log: written to the pane, they stay over fzf until it redraws
    gathering 2>>"${TMPDIR:-/tmp}/claude-sidebar.log" &
    loops=$!
    claude-sidebar-loop "$cache" 2>>"${TMPDIR:-/tmp}/claude-sidebar.log" &
    loops+=" $!"
    trap 'kill $loops 2>/dev/null; rm -rf "$cache"' EXIT
    # no --track: it holds back cursor moves while it finds the item again
    # after each reload, and the list's order is stable without it. Esc and
    # ctrl-c clear the query rather than closing the sidebar
    fzf --read0 --ansi --delimiter '\t' --with-nth 7.. <"$cache/rows.0" \
      --listen "$cache/fzf.sock" \
      --layout reverse --no-scrollbar --info hidden --prompt '' \
      --bind "esc,ctrl-c,ctrl-g,ctrl-q:clear-query" \
      --bind "enter,left-click:execute-silent($self jump {1} {2} {3} {4})+clear-query"
    ;;
  *) "$self" --help >&2; exit 2 ;;
esac
