#!/usr/bin/env bash
# claude-sidebar [rows|pick N|kick|edge|jump|attach]: list every Claude session on this host and
# on each host the sesh config reaches through `ssh-tmux`, grouped by host, and
# jump to one. With no argument, runs the list in fzf; Enter or a click jumps.
# Two background loops keep the list in a cache: one gathers it every second,
# or at once on a kick, so fzf never waits on a host, and draws its frames;
# the other shows them in fzf, 8 a second while a Clawd moves. `tmux-frame`
# runs it as the frame's left pane: a jump moves the frame's right pane, and
# fzf's cursor follows the session on show there however it changed. Run
# elsewhere, a jump moves the usual tmux's most recent client.
# Keeps its cache in ${TMPDIR:-/tmp}/claude-sidebar, and the background loops'
# errors in ${TMPDIR:-/tmp}/claude-sidebar.log rather than over the list.
#   rows              print the list once, as fzf reads it
#   pick N            jump to the entry numbered N (the frame's M-1..9), as
#                     the running sidebar shows it
#   kick              have a running sidebar rebuild now (tmux hooks call it
#                     when a client changes session or window)
#   edge SIDE TTY PANE [HOST]
#                     cross the usual tmux's window edge SIDE (left, up or
#                     down) from PANE, for the client on TTY: left focuses the
#                     sidebar, up and down show the previous or next entry.
#                     Only from the frame's right pane. With HOST, PANE is an
#                     ssh-tmux window's and HOST's active pane decides: not at
#                     that edge, the key goes on to HOST's tmux
#   jump HOST PANE SESSION [ID]
#                     focus PANE on HOST (empty HOST = this one); a remote pane
#                     is shown through the Mac's SESSION, its ssh-tmux relay.
#                     With no PANE, opens background Claude session ID first
#   attach ID         print the pane showing background Claude session ID on
#                     this host, opening it with `claude attach`, tagged
#                     @claude_attach, if none does: in a new window of the tmux
#                     session named for its repo, created if absent
# CLAUDE_CTX_WARN     context percentage an entry's context line turns red at
#                     (default 50)
# SESH_CONFIG         sesh config the hosts come from
#                     (default ~/.config/sesh/sesh.toml)
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
warn=${CLAUDE_CTX_WARN:-50}
sesh_config=${SESH_CONFIG:-$HOME/.config/sesh/sesh.toml}
# ServerAlive drops a master connection to a host gone quiet within 4s, where
# ConnectTimeout does not reach a call made over an existing master
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2
  -o ServerAliveCountMax=2 -o ControlPath=/tmp/claude-sidebar-%C)
cache=${TMPDIR:-/tmp}/claude-sidebar
# the frames a gather draws: every animation in format (running, squatting)
# loops within them, as each one's length divides it
frame_count=12
# a host's one client from the Mac, which runs inside the Mac's tmux (tmux*
# term), as a command run on the host; add -F
relay_client="tmux list-clients -f '#{m:tmux*,#{client_termname}}'"

# the usual tmux server, from inside the frame's server too
work() { env -u TMUX -u TMUX_PANE tmux "$@"; }

# "<pane id> <pane tty>" of the frame's right pane; empty outside the frame
frame_main() {
  tmux list-panes -s -F '#{@frame_main} #{pane_id} #{pane_tty}' 2>/dev/null | awk '$1 == 1 {print $2, $3; exit}'
}

# "<session name>\t<ssh host>" for each sesh entry started by ssh-tmux
remote_hosts() {
  [[ -f $sesh_config ]] || return 0
  awk '/^\[\[session\]\]/ {name=""}
       /^name *=/ {name=$0; sub(/^name *= *"/, "", name); sub(/".*/, "", name)}
       /^startup_command *=.*ssh-tmux / {
         host=$0; sub(/.*ssh-tmux +/, "", host); sub(/[ "].*/, "", host)
         print name "\t" host }' "$sesh_config"
}

# claude-sessions' lines on stdin, tagged with where they came from, sessions
# with a pane first, and desktop app sessions left out unless one has a pane; a
# header line before them, so every host shows even with no sessions. The
# header carries the host's pane on show in the frame, if any
tag() { # $1 label, $2 ssh host, $3 relay session, $4 "unreachable" or empty, $5 pane on show
  jq -nc --arg label "$1" --arg down "$4" --arg current "$5" \
    '{header: true, $label, down: ($down != ""), $current}'
  [[ -n $4 ]] || jq -sc --arg host "$2" --arg relay "$3" \
    'map(select(.entrypoint != "claude-desktop" or .tmux_pane != null))
     | sort_by(.tmux_pane == null)[] + {$host, $relay}'
}

# the columns an fzf item's line has in the pane this runs in, past the 2 of
# fzf's pointer and marker; read on each draw, so the lines follow a resize
line_width() {
  local cols
  cols=$([[ -n $TMUX_PANE ]] && tmux display -p -t "$TMUX_PANE" '#{pane_width}' || tput cols)
  echo $((cols - 2))
}

# one NUL-terminated fzf item per header or session: ssh host, pane, relay
# session, session id (empty only on a header, which is how `jump` tells one),
# entry number, 1 if the frame's right pane shows it, then the display lines.
# Sessions with a pane are numbered in order across hosts, for `pick`. Times
# are in whole minutes, so the rows change only when a session does, or with
# the frame while a Clawd runs or squats. With several animation
# frames, the rows for each, one frame after another
format() { # $@ animation frames, counting from 0 (default 0)
  local frames
  printf -v frames '%s,' "${@:-0}"
  jq -srj --argjson frames "[${frames%,}]" --argjson now "$(printf '%(%s)T' -1)" --argjson warn "$warn" --argjson width "$(line_width)" '
    def ago: if . < 60 then "<1m" elif . < 3600 then "\(. / 60 | floor)m"
             else "\(. / 3600 | floor)h" end;
    # TokyoNight Night as SGR foregrounds: the terminal palette where it has
    # the shade (palette N is 30+N, or 90+N-8 for 8..15), hex where it does not
    def red: "31";
    def green: "32";
    def yellow: "33";
    def blue: "34";
    def terminal_black: "90"; # palette 8, #414868
    def orange: "38;2;255;158;100"; # #ff9e64
    def dark5: "38;2;115;122;162"; # #737aa2, a grey still seen dimmed, where palette 8 is lost
    # . in the colour $sgr, then back to the default foreground (39) rather
    # than a reset, so a background entry stays dimmed
    def paint($sgr): "\u001b[\($sgr)m" + . + "\u001b[39m";
    # context use as a line across the entry, $width columns with the
    # percentage label at its end: the used share a heavy rule, each cell
    # coloured by how far along the bar it sits, green to red as a full
    # context is the bad end. The rest a light dashed rule in terminal_black.
    # All red at $warn. No record ($pct null): the whole line terminal_black,
    # with no label
    def ctxline($pct):
      # the first . cells of a bar $cells long, each in its $palette colour,
      # painted a run of one colour at a time
      def gradient($cells; $palette):
        [range(.) | $palette[. * ($palette | length) / $cells | floor]]
        | reduce .[] as $colour ([];
            if length > 0 and .[-1].colour == $colour then .[-1].cells += 1
            else . + [{$colour, cells: 1}] end)
        | map(.colour as $colour | "━" * .cells | paint($colour))
        | join("");
      if $pct == null then "┈" * $width | paint(terminal_black)
      else
        # padded to 4 columns, so bars up to 99% end in the same column
        (" \($pct)%" | " " * (4 - length) + .) as $label
        | ($width - ($label | length)) as $cells
        | ([$pct * $cells / 100 | round, $cells] | min) as $full
        | ($pct >= $warn) as $warned
        | ($full | gradient($cells; if $warned then [red] else [green, yellow, orange, red] end))
          + ("┈" * ($cells - $full) | paint(terminal_black))
          + ($label | if $warned then paint(red) else . end)
      end;
    # Clawd standing, as Claude Code 2.1.292 draws him in its banner, open
    # eyes and arms down, redrawn 16 pixels wide and 12 tall with a bandana
    # below his head-top: B body, m the bandana, 1 2 3 its stripes, the
    # ribbon a tail at its end and a drop beside the eyes. Two rows each for
    # head-top, bandana, arms, body and feet; the eyes slits one row tall,
    # under the bandana. Drawn as octant cells 2 pixels wide and 4 tall, from rows 0, 4
    # and 8, so keep each cell to two colours, the empty background
    # counting as one: octant draws a cell as one colour and empty, or as
    # two colours and full
    def stand: [
      "..BBBBBBBBBBBB..",
      "..BBBBBBBBBBBB..",
      "..112233mmmmmm3.",
      "..112233mmmmmm3.",
      "..BB..BBBB..BB22",
      "..BBBBBBBBBBBB22",
      "BBBBBBBBBBBBBBBB",
      "BBBBBBBBBBBBBBBB",
      "..BBBBBBBBBBBB..",
      "..BBBBBBBBBBBB..",
      "..B.B......B.B..",
      "..B.B......B.B.."
    ];
    # Clawd running, frame $k of 4: body two columns right, slit eyes, both
    # arms swept left, the stripes at the far end of the bandana. Columns 0
    # to 3 of rows 0 to 3, two octant cells, hold the ribbon streaming left,
    # ribbons[$k], each cell in one stripe colour that changes each frame.
    # The eyes glance a pixel with each step, run_eyes[$k]: centre, a pixel
    # right, centre, a pixel right. The feet step left pair down, all up,
    # right pair down, all up. Same rule as stand: two colours to a cell,
    # empty counting as one
    def run_body: [
      "....BBBBBBBBBBBB",
      "....BBBBBBBBBBBB",
      "....mmmmmm332211",
      "....mmmmmm332211",
      "....BB..BBBB..BB",
      ".BB.BBBBBBBBBBBB",
      ".BB.BBBBBBBBBBBB",
      "....BBBBBBBBBBBB",
      ".BBBBBBBBBBBBBBB",
      ".BBBBBBBBBBBBBBB"
    ];
    def ribbons: [["....", "1...", ".133", ".13."], [".2..", "2.1.", "2.11", "...."],
                  ["....", ".3..", "3322", "...2"], ["2..3", ".23.", ".233", "2..."]];
    def run_feet: [[".....B.B....B.B.", ".....B......B..."],
                   [".....B.B....B.B.", "................"],
                   [".....B.B....B.B.", ".......B......B."],
                   [".....B.B....B.B.", "................"]];
    def run_eyes: ["....BBB..BBBB..B", "....BBBB..BBBB..",
                   "....BBB..BBBB..B", "....BBBB..BBBB.."];
    def run($k):
      [range(4) as $y | ribbons[$k][$y] + run_body[$y][4:]]
      + [run_eyes[$k]] + run_body[5:] + run_feet[$k];
    # Clawd squatting, down: the head drops two rows, the arms come up
    # under the bandana, the eyes below them, the feet squashed to one row,
    # and the ribbon flicks up beside the head-top in one stripe colour. The
    # eyes cannot share a cell row with the bandana, as a cell there would
    # hold the bandana, the body and the empty eye, so they sit in the
    # bottom cell row. Same rule as stand
    def squat: [
      "................",
      "...............2",
      "..BBBBBBBBBBBB.2",
      "..BBBBBBBBBBBB2.",
      "..112233mmmmmm..",
      "..112233mmmmmm..",
      "BBBBBBBBBBBBBBBB",
      "BBBBBBBBBBBBBBBB",
      "..BB..BBBB..BB..",
      "..BBBBBBBBBBBB..",
      "..BBBBBBBBBBBB..",
      "..B.B......B.B.."
    ];
    # halfway down: standing, knees bent, the feet squashed to one row. The
    # head cannot drop one row alone, as the top cell row would hold the
    # empty row, the head-top and the bandana
    def crouch: stand[:10] + ["..BBBBBBBBBBBB..", "..B.B......B.B.."];
    # the poses of a run, and of a squat: standing a while, then down and back
    def running: [range(4) as $k | run($k)];
    def squatting: [range(8) | stand] + [crouch, squat, squat, crouch];
    # the octant for each set of lit pixels in a cell, bit n-1 for pixel n:
    # 1 2 / 3 4 / 5 6 / 7 8. Written out from Unicode names by Python 3.15
    # unicodedata: BLOCK OCTANT-n at U+1CD00 lights the pixels its digits
    # name, and the 26 sets Unicode encodes elsewhere are the quadrants,
    # U+1FB82, U+2582, U+1FB85, U+2586, U+1CEA8, U+1CEAB, U+1CEA3, U+1CEA0,
    # U+1FBE6 and U+1FBE7
    def octants:
      " 𜺨𜺫🮂𜴀▘𜴁𜴂𜴃𜴄▝𜴅𜴆𜴇𜴈▀" +
      "𜴉𜴊𜴋𜴌🯦𜴍𜴎𜴏𜴐𜴑𜴒𜴓𜴔𜴕𜴖𜴗" +
      "𜴘𜴙𜴚𜴛𜴜𜴝𜴞𜴟🯧𜴠𜴡𜴢𜴣𜴤𜴥𜴦" +
      "𜴧𜴨𜴩𜴪𜴫𜴬𜴭𜴮𜴯𜴰𜴱𜴲𜴳𜴴𜴵🮅" +
      "𜺣𜴶𜴷𜴸𜴹𜴺𜴻𜴼𜴽𜴾𜴿𜵀𜵁𜵂𜵃𜵄" +
      "▖𜵅𜵆𜵇𜵈▌𜵉𜵊𜵋𜵌▞𜵍𜵎𜵏𜵐▛" +
      "𜵑𜵒𜵓𜵔𜵕𜵖𜵗𜵘𜵙𜵚𜵛𜵜𜵝𜵞𜵟𜵠" +
      "𜵡𜵢𜵣𜵤𜵥𜵦𜵧𜵨𜵩𜵪𜵫𜵬𜵭𜵮𜵯𜵰" +
      "𜺠𜵱𜵲𜵳𜵴𜵵𜵶𜵷𜵸𜵹𜵺𜵻𜵼𜵽𜵾𜵿" +
      "𜶀𜶁𜶂𜶃𜶄𜶅𜶆𜶇𜶈𜶉𜶊𜶋𜶌𜶍𜶎𜶏" +
      "▗𜶐𜶑𜶒𜶓▚𜶔𜶕𜶖𜶗▐𜶘𜶙𜶚𜶛▜" +
      "𜶜𜶝𜶞𜶟𜶠𜶡𜶢𜶣𜶤𜶥𜶦𜶧𜶨𜶩𜶪𜶫" +
      "▂𜶬𜶭𜶮𜶯𜶰𜶱𜶲𜶳𜶴𜶵𜶶𜶷𜶸𜶹𜶺" +
      "𜶻𜶼𜶽𜶾𜶿𜷀𜷁𜷂𜷃𜷄𜷅𜷆𜷇𜷈𜷉𜷊" +
      "𜷋𜷌𜷍𜷎𜷏𜷐𜷑𜷒𜷓𜷔𜷕𜷖𜷗𜷘𜷙𜷚" +
      "▄𜷛𜷜𜷝𜷞▙𜷟𜷠𜷡𜷢▟𜷣▆𜷤𜷥█";
    # TokyoNight Night shades a bandana takes, clear of the state colours:
    # red, green, blue, magenta, cyan, teal, fg, blue1, purple
    def bandana_colours: [red, green, blue, "35", "36", "38;2;115;218;202",
      "38;2;192;202;245", "38;2;42;195;222", "38;2;157;124;216"];
    # djb2 of a string, kept under 2^31 so jq, counting in doubles, stays exact
    def djb: reduce explode[] as $c (5381; (. * 33 + $c) % 2147483647);
    # four different bandana colours for session $id, main then stripes, from
    # a stable hash of the id, so a session wears the same bandana on every
    # refresh and from either host. Each pick takes the hash modulo the
    # colours left and passes the quotient on to the next
    def bandana($id):
      [foreach range(4) as $_ ({hash: ($id | djb), left: bandana_colours};
         (.left | length) as $n | (.hash % $n) as $i
         | {hash: (.hash / $n | floor), left: (.left | del(.[$i])), pick: .left[$i]};
         .pick)];
    # foreground . as the same colour for the background: 3x as 4x, 9x as
    # 10x, 38;2 as 48;2
    def as_background:
      if startswith("38;") then "48" + .[2:] else tonumber + 10 | tostring end;
    # . in the foreground $fg on the background $bg, both given as
    # foregrounds, then back to the default colours
    def paint($fg; $bg):
      "\u001b[\($fg);\($bg | as_background)m" + . + "\u001b[39;49m";
    # foreground . halfway to the background, #1a1b26, as Ghostty draws a
    # faint (SGR 2) foreground at its faint-opacity of 0.5; the palette
    # shades as TokyoNight Night sets them
    def faded:
      (if startswith("38;2;") then .[5:] | split(";") | map(tonumber)
       else {"31": [247, 118, 142], "32": [158, 206, 106], "33": [224, 175, 104],
             "34": [122, 162, 247], "35": [187, 154, 247], "36": [125, 207, 255]}[.] end)
      | [., [26, 27, 38]] | transpose | map(add / 2 | floor | tostring)
      | "38;2;" + join(";");
    # a cell of 8 pixels (colours or null, left to right, top to bottom) as
    # its octant: the first lit pixel is the ink and lights the glyph, and a
    # second colour filling the rest of the cell is its background, closed
    # again (49) so it stops at the cell. A second colour in a cell that is
    # not full is not drawn. Faint dims only a foreground, so where $faint,
    # a cell with a background turns faint off (22) and draws both colours
    # faded, then turns faint back on
    def octant($faint):
      map(values) as $lit
      | $lit[0] as $ink
      | (if ($lit | length) == 8 then $lit - [$ink] | first else null end)
          as $background
      | ([range(8) as $k | select(.[$k] != null and .[$k] == $ink) | pow(2; $k)] | add // 0) as $bits
      | octants[$bits:$bits + 1]
      | if $ink == null then .
        elif $background == null then paint($ink)
        elif $faint then
          "\u001b[22m" + paint($ink | faded; $background | faded) + "\u001b[2m"
        else paint($ink; $background) end;
    # the poses session $r cycles through, a pose a frame, and its phase
    # into them. Working, he runs; idle with subagents running, he squats,
    # each session at its own phase from its id; otherwise he stands
    def animation($r):
      if $r.state == "working" then {poses: running, phase: 0}
      elif $r.state == "idle" and $r.subagents > 0
      then {poses: squatting, phase: ($r.session_id | djb)}
      else {poses: [stand], phase: 0} end;
    # Clawd for session $r, wearing its bandana, as three lines, his body in
    # the colour for its state: working orange, waiting yellow, idle grey,
    # the only states claude-session-state writes. In the pose of its
    # animation for frame $frame. `serve` ticks while any frame differs from
    # frame 0. $faint as in octant
    def picture($r; $frame; $faint):
      (bandana($r.session_id) as [$main, $s1, $s2, $s3]
        | {B: {working: orange, waiting: yellow, idle: dark5}[$r.state],
           m: $main, "1": $s1, "2": $s2, "3": $s3}) as $palette
      | (animation($r) | .poses[(.phase + $frame) % (.poses | length)]
         | map(split("") | map($palette[.]))) as $pixels
      | [range(3) as $line
          | [range(8) as $cell
              | [range(4) as $y | range(2) as $x | $pixels[4 * $line + $y][2 * $cell + $x]]
              | octant($faint)]
          | join("")];
    . as $tagged
    | $frames[] as $frame
    | $tagged
    | foreach .[] as $r ({n: 0, cur: ""};
      if $r.header then .cur = $r.current
      elif $r.tmux_pane != null then .n += 1 else . end;
      [$r, .n, .cur])
    | .[0] as $r | .[1] as $n | .[2] as $cur
    | if $r.header then
        ["", "", "", "", "", "",
         # paint closes only the colour, so the reset ends the bold
         ($r.label | paint("1;\(blue)")) + "\u001b[0m"
         + (if $r.down then "  " + ("unreachable" | paint(red)) else "" end)
         # a blank second line, so the heading stands apart from the entries,
         # as a braille blank (U+2800) since fzf drops a trailing line of spaces
         + "\n\u2800"]
      else
        ($r.context.used_pct) as $pct
        | ($r.tmux_pane != null) as $numbered
        # a session with no pane (a --bg one, or a daemon) is dimmed
        | (if $numbered then "" else "\u001b[2m" end) as $dim
        | picture($r; $frame; $numbered | not) as [$pic0, $pic1, $pic2]
        | [$r.host, ($r.tmux_pane // ""), $r.relay, $r.session_id,
           (if $numbered then "\($n)" else "" end),
           (if $numbered and $r.tmux_pane == $cur then "1" else "" end),
           $dim + $pic0 + " " + (if $numbered then "\($n)" else " " end) + " \($r.cwd | split("/") | last)\n"
           + $dim + $pic1 + "   \($r.name // $r.session_id[:8])\n"
           + $dim + $pic2 + "   \($r.state) \($now - $r.since | ago)"
           # running subagents in the working colour, so an idle session
           # whose subagents are still at work stands out
           + (if $r.subagents > 0 then "  " + ("+\($r.subagents)" | paint(orange)) else "" end)
           + (if $numbered then "" else "  " + $dim + "background\u001b[0m" end)
           # reset at the end, or the dim of a background entry leaks into
           # the entries fzf draws after it
           + "\n" + $dim + ctxline($pct) + "\u001b[0m"]
      end
    | join("\t") + "\u0000"'
}

# every host's tagged lines, local first
collect() {
  local tmp; tmp=$(mktemp -d) || return
  # what the frame's right pane shows: a local pane, or a host's relay window
  local main shown="" relay_host=""
  main=$(frame_main)
  [[ -n $main ]] && read -r shown relay_host < <(work display -p -c "${main#* }" '#{pane_id} #{@ssh_tmux}')
  # hosts in parallel, so an unreachable one costs one ConnectTimeout, not more
  { claude-sessions | tag local "" "" "" "$([[ -z $relay_host ]] && echo "$shown")" >"$tmp/0"; } &
  local i=0 name host
  while IFS=$'\t' read -r name host; do
    i=$((i + 1))
    {
      # one master connection per host, so a refresh is not a login. After
      # the sessions, \036 and the pane the Mac's client there is on
      if out=$(ssh "${ssh_opts[@]}" -o ControlMaster=auto -o ControlPersist=60 "$host" \
        "claude-sessions; printf '\036'; $relay_client -F '#{pane_id}' | head -1" \
        2>/dev/null); then
        local remote_shown=""
        [[ $relay_host == "$host" ]] && remote_shown=${out#*$'\036'}
        tag "$name" "$host" "$name" "" "${remote_shown//$'\n'/}" <<<"${out%%$'\036'*}"
      else
        tag "$name" "$host" "$name" unreachable "" </dev/null
      fi >"$tmp/$i"
    } &
  done < <(remote_hosts)
  wait
  cat "$tmp"/* | grep -v '^$'
  rm -rf "$tmp"
}

# the tmux session for directory $1: named for the repo holding it, so a
# subdirectory and every linked worktree of a repo share one, and for $1 itself
# outside a repo. Either way the name sesh gives the repo's root, or $1, so on
# the Mac a repo's sesh session: the basename, with `.` and `:`, which a tmux
# target cannot hold, turned to `_`
tmux_session_for() { # $1 directory
  local dir=$1 common_git_dir top name
  common_git_dir=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  case $common_git_dir in
    # the main checkout's .git, which its worktrees share
    */.git) dir=${common_git_dir%/.git} ;;
    # a submodule's, under its superproject's .git/modules, whose parent is
    # no checkout: name it for its own top level instead
    ?*) top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && dir=$top ;;
  esac
  name=$(basename "$dir")
  echo "${name//[.:]/_}"
}

# the pane showing background session $1 on this host. If none does, opens one
# in a new window of the tmux session named for the session's repo, creating
# that tmux session detached if absent
attach() { # $1 session id
  local row pane cwd job tmux_session open
  # claude-sessions now, not the cached rows, so a second select before the
  # next refresh finds the first window by its tag, and a tagged pane since
  # switched to another session is not reused
  row=$(claude-sessions | jq -c --arg s "$1" 'select(.session_id == $s)')
  pane=$(jq -r '.tmux_pane // empty' <<<"$row")
  if [[ -z $pane ]]; then
    cwd=$(jq -r '.cwd // empty' <<<"$row")
    [[ -n $cwd ]] || return 1
    # `claude attach` takes the daemon's job id, which need not be the session's
    job=$(claude agents --json | jq -r --arg s "$1" '.[] | select(.sessionId == $s) | .id // empty')
    [[ -n $job ]] || return 1
    tmux_session=$(tmux_session_for "$cwd")
    # tagged in the same call, so a select racing this one finds the window.
    # The new window, or session, becomes current, which `set` without -t
    # relies on. The pane, not the window, so a split beside it does not share
    # the tag
    # `=` matches the name exactly, where a bare target also takes a prefix
    if work has-session -t "=$tmux_session" 2>/dev/null; then
      open=(new-window -t "=$tmux_session:")
    else
      open=(new-session -d -s "$tmux_session")
    fi
    pane=$(work "${open[@]}" -P -F '#{pane_id}' -c "$cwd" "claude attach $job" \; \
      set -p @claude_attach "$1") || return 1
  fi
  echo "$pane"
}

# a jump moving the right pane's client: $cache/moving.<pid> before it moves;
# once it has (on a host, once its ssh is back), a new value in
# $cache/jumped, written whole, and only then the mark goes. A gather keeps
# the value it began with, and `serve` takes the cursor to the session on
# show only if that value still stands and no jump is moving, however slow
# the host
moving() { [[ -d $cache ]] && : >"$cache/moving.$$"; return 0; }
moved() {
  [[ -d $cache ]] || return 0
  echo "$EPOCHREALTIME-$$" >"$cache/jumped.$$" && mv "$cache/jumped.$$" "$cache/jumped"
  rm -f "$cache/moving.$$"
}

jump() { # $1 ssh host, $2 pane, $3 relay session, $4 session id
  local host=$1 pane=$2 relay=$3 id=$4
  [[ -n $id ]] || return 0 # a header
  # inside the frame, move the client in its right pane and focus that pane
  local main client=()
  main=$(frame_main)
  [[ -n $main ]] && client=(-c "${main#* }")
  if [[ -z $host ]]; then
    [[ -n $pane ]] || pane=$(attach "$id") || return
    moving
    work switch-client "${client[@]}" -t "$pane" \; select-window -t "$pane" \; select-pane -t "$pane"
    moved
  else
    # the Mac window holding this host's relay, tagged by ssh-tmux
    local window
    window=$(work list-windows -a -F '#{window_id} #{@ssh_tmux}' | awk -v h="$host" '$2 == h {print $1; exit}')
    [[ -n $window ]] || { tmux display-message "open $relay first (prefix f)"; return; }
    moving
    work switch-client "${client[@]}" -t "$window" \; select-window -t "$window"
    # the host's client from the Mac moves, in the background, so a slow link
    # does not hold up the caller, which for a click is fzf itself. The kick
    # waits for it, or the gather it brings could see the host's old session
    # on show and take the cursor back
    {
      ssh "${ssh_opts[@]}" "$host" "
      client=\$($relay_client -F '#{client_name}' | head -1)
      [ -n \"\$client\" ] || exit
      pane='$pane'
      [ -n \"\$pane\" ] || pane=\$(claude-sidebar attach '$id') || exit
      tmux switch-client -c \"\$client\" -t \"\$pane\" \\; select-window -t \"\$pane\" \\; select-pane -t \"\$pane\""
      moved
      kick
    } </dev/null >/dev/null 2>&1 &
  fi
  [[ -n $main ]] && tmux select-pane -t "${main%% *}"
  # rebuild now, so the list shows the move; a host's jump kicks above, once
  # its client there has moved
  [[ -n $host ]] || kick
}

# wake a running sidebar's gathering through the fifo $cache/kick, opened
# read and write, so a sidebar gone and its fifo left behind cannot hang a
# tmux hook on the open
kick() {
  local fd
  [[ -p $cache/kick ]] || return 0
  exec {fd}<>"$cache/kick"
  echo >&"$fd"
  exec {fd}>&-
}

# the usual tmux's Cmd+Left/Up/Down bindings call this at a window's edge, and
# always in an ssh-tmux window, whose edges are the host's
edge() { # $1 left|up|down, $2 client tty, $3 pane, $4 ssh host
  local side=$1 tty=$2 pane=$3 host=$4 key pane_at
  case $side in
    left) key=C-M-Left pane_at=pane_at_left ;;
    up) key=C-M-Up pane_at=pane_at_top ;;
    down) key=C-M-Down pane_at=pane_at_bottom ;;
    *) return 2 ;;
  esac
  # no sidebar to cross into: the host's key is still the host's
  if ! from_frame "$tty"; then
    [[ -z $host ]] || work send-keys -t "$pane" "$key"
    return 0
  fi
  # the pane at the edge, then the rest of its window's; in an ssh-tmux
  # window, the host's active pane and its window
  local panes
  if [[ -n $host ]]; then
    local at_edge
    read -r at_edge panes < <(ssh "${ssh_opts[@]}" "$host" "$relay_client -F '#{$pane_at} #{pane_id} #{window_id}' | head -1 |
      while read -r at p w; do echo \$at \$p \$(tmux list-panes -t \$w -F '#{pane_id}'); done" 2>/dev/null)
    # the host's pane can still move that way, or the host did not answer
    [[ $at_edge == 1 ]] || { work send-keys -t "$pane" "$key"; return 0; }
  else
    panes="$pane $(work list-panes -t "$pane" -F '#{pane_id}' | tr '\n' ' ')"
  fi
  case $side in
    left) tmux select-pane -t '{left}' ;; # the sidebar, as the frame's M-s finds it
    up) step "$host" "$panes" -1 ;;
    down) step "$host" "$panes" 1 ;;
  esac
}

# whether the usual tmux's client on tty $1 is the frame's right pane. Points
# TMUX at the frame's server first, so frame_main, jump and pick reach the
# frame as the tmux they run in, as they do from fzf
from_frame() {
  local socket main
  socket=$(tmux -L frame display -p '#{socket_path}' 2>/dev/null) || return
  export TMUX=$socket,0,0
  main=$(frame_main)
  [[ -n $main && ${main#* } == "$1" ]]
}

# pick the entry $3 numbers away from the first of panes $2 (space-separated)
# that is a numbered entry on ssh host $1 (empty for this one), so a shell
# under Claude steps from its window's entry; nothing past either end, or when
# no pane is one. The panes, not the rows' entry on show, which lags any change
# by up to a refresh, so a held key walks the list
step() {
  local entry
  entry=$(perl -0ne 'BEGIN { ($h, $ps) = splice @ARGV, 0, 2; @p = split " ", $ps }
    chomp; @f = split /\t/, $_, -1;
    $n{$f[1]} = $f[4] if $f[0] eq $h && $f[4] ne "";
    END { for (@p) { if (exists $n{$_}) { print $n{$_}; last } } }' "$1" "$2" "$cache/rows.0")
  [[ -n $entry ]] && pick $((entry + $3))
  return 0
}

# the position in fzf's list (from 1) of the first row whose field $1 is $2
position() {
  perl -0ne 'BEGIN { ($f, $v) = splice @ARGV, 0, 2 }
    $i++; chomp; if ((split /\t/, $_, -1)[$f - 1] eq $v) { print $i; exit }' "$1" "$2" "$cache/rows.0"
}

# run fzf actions in the running sidebar
fzf_do() { curl -sf --unix-socket "$cache/fzf.sock" -X POST http://localhost -d "$1"; }

# the tagged lines `pick` reads, collected from every host and replaced whole,
# so a reader never sees half of them
gather() { collect >"$cache/tagged.new" && mv "$cache/tagged.new" "$cache/tagged"; }

# the rows fzf shows, one file for each frame of the cycle, rows.0 on: all
# formatted from the tagged lines in one jq run, then each replaced whole, as
# `step` and `position` read rows.0 too. Every frame has the same items, so
# the output splits into equal parts. $cache/moves is there while any frame
# differs from rows.0, so `serve` knows a Clawd moves without reading them
draw() {
  local frames=()
  for ((k = 0; k < frame_count; k++)); do frames+=("$k"); done
  format "${frames[@]}" <"$cache/tagged" >"$cache/frames.new" &&
    perl -0 -e '($dir, $count) = @ARGV; @items = <STDIN>; @items or exit 1;
      $n = @items / $count; $rows0 = join "", @items[0 .. $n - 1];
      for $k (0 .. $count - 1) {
        @rows = @items[$k * $n .. ($k + 1) * $n - 1];
        open my $f, ">", "$dir/rows.$k.new" or die;
        print $f @rows;
        close $f or die;
        rename "$dir/rows.$k.new", "$dir/rows.$k" or die;
        $moves ||= join("", @rows) ne $rows0 }
      if ($moves) { open my $f, ">", "$dir/moves" or die } else { unlink "$dir/moves" }' \
      "$cache" "$frame_count" <"$cache/frames.new"
}

# empty fd $1 of the lines waiting on it; succeeds if there were any
drained() {
  local any=1
  while read -r -t 0 -u "$1" && read -r -u "$1"; do any=0; done
  return "$any"
}

# gather and draw every second, or as soon as a kick comes through the fifo
# $cache/kick, then wake `serve` with a line to the fifo $cache/gathered: the
# value $cache/jumped had when the gather began, then "moved" when a kick came
# during it, so what it saw on show in the frame may already be gone, and
# gather again at once
gathering() {
  local kicks since
  exec {kicks}<>"$cache/kick"
  while :; do
    drained "$kicks" # the kicks this gather answers
    read -r since <"$cache/jumped"
    gather && draw
    if drained "$kicks"; then
      echo "$since moved" >"$cache/gathered"
      continue
    fi
    echo "$since" >"$cache/gathered"
    read -r -t 1 -u "$kicks"
  done
}

# wait for `serve`, reading and moving its locals: for the next gather on fd
# $gathered, its line in $gathered_line, or, while a Clawd is $animating,
# for that or the tick at $next_tick_us, then moving it on by $tick_us.
# Succeeds if a gather came, fails at a tick. The waits are read timeouts,
# with no sleep to fork; a read that times out still sets its variable, so
# the line goes to $gathered_line only once read
await_gather() {
  # times in microseconds: EPOCHREALTIME without its decimal separator, a
  # point or a comma by locale
  local now delay line
  if [[ $animating != true ]]; then
    read -r -u "$gathered" line || return
    gathered_line=$line
    next_tick_us=$((${EPOCHREALTIME/[.,]/} + tick_us))
    return 0
  fi
  delay=$((next_tick_us - ${EPOCHREALTIME/[.,]/}))
  if ((delay > 0)); then
    printf -v delay '0.%06d' "$delay"
    read -r -t "$delay" -u "$gathered" line && gathered_line=$line && return 0
  fi
  now=${EPOCHREALTIME/[.,]/}
  next_tick_us=$((next_tick_us + tick_us))
  # behind: drop the missed ticks
  ((next_tick_us > now)) || next_tick_us=$((now + tick_us))
  return 1
}

# show the frames `gathering` draws: after each gather the same frame of the
# new rows, and at every tick, 8 a second, the next frame while one differs
# from another, so a Clawd runs or squats; with none moving it sleeps until the
# next gather, so the rows change no more than once a second. With none
# moving, fzf reloads only when the rows on show changed; while one moves, at
# every tick. Its cursor moves only when the right pane's session did, so it
# is not taken from an entry being browsed to
serve() {
  local frame=0 animating=false check_shown=false fzf_has_rows gathered_line since jumped sum last_sum="" shown last_shown=""
  # ticks kept to a schedule, so a slow reload does not slow the frame rate
  local tick_us=125000 next_tick_us gathered
  # read and write, so the fifo always has a reader and a writer, and `read`
  # waits for a line rather than seeing end of file
  exec {gathered}<>"$cache/gathered"
  while :; do
    if await_gather; then
      # whether anything moves is whatever `picture` draws differently
      if [[ -e $cache/moves ]]; then animating=true; else animating=false; fi
      # the value $cache/jumped had when the gather began. A gather a kick
      # overtook may have seen the session on show before a jump, and would
      # take the cursor back from where the jump put it
      since=${gathered_line%% *}
      if [[ $gathered_line == *" moved" ]]; then check_shown=false; else check_shown=true; fi
      # with none moving, the new rows if they changed; with one, the next
      # tick shows them, so the frames stay evenly spaced. The sum is without
      # field 6, the session on show, which moves the cursor, not the rows
      if [[ $animating == false ]]; then
        sum=$(perl -0pe 's/^((?:[^\t]*\t){5})[^\t]*/$1/' "$cache/rows.$frame" | cksum)
        [[ $sum != "$last_sum" ]] && fzf_do "reload-sync(cat '$cache/rows.$frame')" && last_sum=$sum
        fzf_has_rows=true
      else
        fzf_has_rows=false
      fi
    else
      # a tick: the next frame
      frame=$(((frame + 1) % frame_count))
      fzf_do "reload-sync(cat '$cache/rows.$frame')"
      last_sum=""
      fzf_has_rows=true
    fi
    # the cursor moves once fzf has the rows its position is counted in, and
    # not for a gather a jump came after, or while one moves: checked last,
    # just before the post, so a pick cannot land in between
    if [[ $check_shown == true && $fzf_has_rows == true ]]; then
      check_shown=false
      shown=$(position 6 1)
      if [[ -n $shown && $shown != "$last_shown" ]]; then
        read -r jumped <"$cache/jumped"
        if [[ $jumped == "$since" ]] && ! compgen -G "$cache/moving.*" >/dev/null; then
          fzf_do "pos($shown)" && last_shown=$shown
        fi
      fi
    fi
  done
}

pick() { # $1 entry number, counted as `format` numbers them
  (( $1 >= 1 )) || return 0 # jq would count 0 and below from the end
  local host pane relay id
  # the running sidebar's list, so N is the number on screen
  local tagged=$cache/tagged
  [[ -f $tagged ]] || { mkdir -p "$cache"; collect >"$cache/once"; tagged=$cache/once; }
  IFS=$'\x1f' read -r host pane relay id < <(jq -sr --argjson n "$1" '
    [.[] | select((.header | not) and .tmux_pane != null)][$n - 1] // empty
    | [.host, .tmux_pane, .relay, .session_id] | join("\u001f")' "$tagged")
  [[ -n $pane ]] || return 0
  jump "$host" "$pane" "$relay" "$id"
  [[ -S $cache/fzf.sock ]] && fzf_do "pos($(position 5 "$1"))"
}

case $1 in
  rows) collect | format ;;
  pick) pick "$2" ;;
  kick) kick ;;
  edge) edge "$2" "$3" "$4" "$5" ;;
  jump) jump "$2" "$3" "$4" "$5" ;;
  attach) attach "$2" ;;
  "")
    mkdir -p "$cache" && rm -f "$cache/gathered" "$cache/kick" "$cache"/moving.* &&
      mkfifo "$cache/gathered" "$cache/kick" && moved && gather && draw
    # errors to a log: written to the pane, they stay over fzf until it redraws
    gathering 2>>"${TMPDIR:-/tmp}/claude-sidebar.log" &
    loops=$!
    serve 2>>"${TMPDIR:-/tmp}/claude-sidebar.log" &
    loops+=" $!"
    trap 'kill $loops 2>/dev/null; rm -rf "$cache"' EXIT
    # no --track: it holds back cursor moves while it finds the item again
    # after each reload, and the list's order is stable without it. Esc and
    # ctrl-c clear the query rather than closing the sidebar
    fzf --read0 --ansi --delimiter '\t' --with-nth 7.. <"$cache/rows.0" \
      --listen "$cache/fzf.sock" \
      --layout reverse --no-scrollbar --info hidden --prompt '' \
      --bind "esc,ctrl-c,ctrl-g,ctrl-q:clear-query" \
      --bind "enter,left-click:execute-silent($self jump {1} {2} {3} {4})+clear-query"
    ;;
  *) "$self" --help >&2; exit 2 ;;
esac
