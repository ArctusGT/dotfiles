#!/usr/bin/env bash
# ssh-tmux HOST [SESSION [DIR]]: attach to tmux on HOST and reconnect when
# the connection drops (sleep, wifi change, idle timeout).
# Without SESSION, attaches to the host's most recently used session, or
# creates `main` if the host has none. With SESSION, attaches to (or creates)
# that session, starting in DIR; quote DIR ('~/repo') so ~ expands remotely.
# Detaching or exiting the remote tmux ends the loop.
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
host=$1 session=$2
[[ -n $host ]] || { echo "usage: ssh-tmux HOST [SESSION [DIR]]" >&2; exit 2; }
if [[ -n $session ]]; then
  remote="tmux -u new -A -s '$session'"
  [[ -n $3 ]] && remote+=" -c $3"
else
  # Most recently used session, even one still attached: after a sleep or
  # wifi drop the host can hold the dead connection's client for a while, and
  # a bare `attach` would skip that session for another one. -d detaches the
  # stale client so the host keeps one.
  remote='s=$(tmux list-sessions -F "#{session_last_attached} #{session_name}" 2>/dev/null | sort -rn | head -1 | cut -d" " -f2-)
tmux -u new -AD -s "${s:-main}"'
fi

# tag the local window so a bell from the remote marks it (see alert-bell hook)
if [[ -n $TMUX_PANE ]]; then
  tmux set -w -t "$TMUX_PANE" @ssh_tmux "$host"
  trap 'tmux set -wu -t "$TMUX_PANE" @ssh_tmux' EXIT
fi

while :; do
  ssh -t -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 \
    "$host" "$remote"
  (( $? == 255 )) || break # 255 = connection error; anything else was deliberate
  # undo mouse reporting, alt screen and hidden cursor left by the remote tmux
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1049l\e[?25h'
  echo "lost connection to $host, reconnecting in 3s (ctrl-c to stop)"
  sleep 3
done
