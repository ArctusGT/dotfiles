#!/usr/bin/env bash
# claude-sessions: print one JSON object per live Claude session on this host,
# from the state files `claude-session-state` and `claude-statusline` keep in
# ${XDG_STATE_HOME:-~/.local/state}/claude-sessions.
# Each object carries the session's state file plus `subagents` (a count) and
# `context` (the status line's last record, or null), and `name`, the one
# Claude Code's own record holds for it, else the status line's. Removes the files of a
# session whose process is gone, which is how a killed session is cleared.
# A background session open in a pane `claude-sidebar` tagged @claude_attach,
# on the default tmux server, gets that pane as `tmux_pane`. A recorded pane
# the default server no longer has is dropped to null. A pre-warmed spare, which
# a `claude daemon` keeps idle for its next background job and which has
# nothing to attach to, is left out.
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions
[[ -d $dir ]] || exit 0
shopt -s nullglob

# {pane: session id or ""} for every pane, the session id where the pane is
# tagged @claude_attach; the default server even when run from inside the
# sidebar's frame
panes=$(env -u TMUX -u TMUX_PANE tmux list-panes -a \
  -F '#{pane_id} #{@claude_attach}' 2>/dev/null |
  jq -Rn '[inputs | split(" ") | {(.[0]): (.[1] // "")}] | add // {}')
attached=$(jq -c 'to_entries | map(select(.value != "") | {(.value): .key}) | add // {}' <<<"$panes")

# {session id: {name, spare}} from Claude Code's own records
# (~/.claude/sessions/<pid>.json); keyed by id, since their pid need not be
# the one the hooks record
records=$(cat ~/.claude/sessions/*.json 2>/dev/null |
  jq -sc 'map({(.sessionId): {name, spare}}) | add // {}' 2>/dev/null)
[[ -n $records ]] || records='{}'

for state_file in "$dir"/*.json; do
  [[ $state_file == *.context.json ]] && continue
  sid=$(basename "$state_file" .json)
  pid=$(jq -r '.pid // empty' "$state_file" 2>/dev/null) || continue
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$state_file" "$dir/$sid.context.json" "$dir/$sid.agents"
    continue
  fi
  agents=("$dir/$sid.agents"/*)
  context=null
  [[ -f $dir/$sid.context.json ]] && context=$(<"$dir/$sid.context.json")
  jq -c --argjson n "${#agents[@]}" --argjson ctx "$context" \
    --argjson attached "$attached" --argjson panes "$panes" --argjson records "$records" \
    'select($records[.session_id].spare != true)
     | . + {name: ($records[.session_id].name // $ctx.name?), subagents: $n, context: $ctx,
          tmux_pane: ((.tmux_pane | select(. != null and $panes[.] != null)) // $attached[.session_id])}' "$state_file"
done
