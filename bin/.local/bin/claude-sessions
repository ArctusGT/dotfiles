#!/usr/bin/env bash
# claude-sessions: print one JSON object per live Claude session on this host,
# from the state files `claude-session-state` and `claude-statusline` keep in
# ${XDG_STATE_HOME:-~/.local/state}/claude-sessions.
# Each object carries the session's state file plus `subagents` (a count),
# `context` (the status line's last record, or null), `name` (the one
# Claude Code's own record holds for it, else the status line's) and `repo`
# (the repo root its cwd is in, `~` for HOME; null for no cwd). Removes the
# files of a session whose process is gone, which is how a killed session is
# cleared. Where Claude Code keeps its own records, a session is live only
# while one of them, with a live pid, names it.
# `tmux_pane` is the pane on the default tmux server showing the session, its
# recorded one first. A pane shows the session its title names, alone among
# the live ones, if it runs Claude Code; else the one tagged on it
# (@claude_attach, by `claude-sidebar`); else the one the hooks recorded in
# it. A pane whose interactive session parked its conversation as a live
# background job shows that job instead, as Claude Code goes on showing it
# there. An interactive session whose pane shows another one is left out, since
# that pane is the other session's entry. A pre-warmed spare, which a `claude
# daemon` keeps idle for its next background job and which has nothing to
# attach to, is left out.
# claude-sidebar-loop (the repo's crate) reads this host's sessions by these
# same rules, in its `sessions`; change both. The sidebar reads the host it
# runs on through the binary, and runs this only on the hosts it reaches over
# ssh.
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude-sessions
[[ -d $dir ]] || exit 0
shopt -s nullglob extglob

# every pane on the default server, even when run from inside the sidebar's
# frame: its id, its @claude_attach tag, whether it runs Claude Code, whether
# its window carries @claude_wait (unseen news), and its title with Claude
# Code's status glyph (idle ✳, working ◐ ◑) taken off
panes=$(env -u TMUX -u TMUX_PANE tmux list-panes -a \
  -F '#{pane_id}	#{@claude_attach}	#{pane_current_command}	#{@claude_wait}	#{pane_title}' 2>/dev/null |
  jq -Rn '[inputs | split("\t") | {id: .[0], tag: .[1], runs_claude: (.[2] == "claude"),
           waiting: ((.[3] // "") != ""),
           title: (.[4:] | join("\t") | sub("^[✳◐◑] "; ""))}]')
[[ -n $panes ]] || panes='[]'

# {session id: {name, spare, kind, jobId, parkedJobId, pid}} from Claude
# Code's own records (~/.claude/sessions/<pid>.json); keyed by id, since
# their pid need not be the one the hooks record. With no records the glob
# vanishes under nullglob, so `cat` gets /dev/null as stdin rather than
# waiting on the caller's
records=$(cat ~/.claude/sessions/*.json </dev/null 2>/dev/null |
  jq -sc 'map({(.sessionId): {name, spare, kind, jobId, parkedJobId, pid}}) | add // {}' 2>/dev/null)
[[ -n $records ]] || records='{}'

# this and the exit after the loop are not only shortcuts: jq given no files
# reads the caller's stdin
state_files=("$dir"/!(*.context).json)
((${#state_files[@]})) || exit 0

# each session's id, pid and cwd, a line apiece separated by \x1f, which
# unlike a tab does not run together around an empty field; the pid empty for
# none: the record's where there are records, since a background job's hooks
# run under the `claude daemon`, so its state file can hold the daemon's
# pid, which outlives the job. A session missing from the records has ended
session_pids() {
  jq -r --argjson records "$records" '(input_filename | sub(".*/"; "") | rtrimstr(".json")) as $sid
    | [$sid, (if $records == {} then .pid else $records[$sid].pid end // ""), .cwd // ""]
    | map(tostring) | join("\u001f")' \
    "${state_files[@]}" 2>/dev/null
}

# the repo root directory $1 is in, as `claude-sidebar` names tmux sessions:
# a linked worktree's main checkout, a subdirectory's top level, and $1
# itself outside a repo; HOME as `~`. Read from the .git files rather than
# asked of git, which this would run for every session every second
repo_of() { # $1 directory
  local dir=$1 gitdir
  while :; do
    if [[ -d $dir/.git ]]; then
      break
    elif [[ -f $dir/.git ]]; then
      # a worktree's .git names its gitdir in its main checkout's .git; a
      # submodule's, one under its superproject's, which is no checkout
      read -r _ gitdir <"$dir/.git"
      [[ $gitdir == /*/.git/worktrees/* ]] && dir=${gitdir%%/.git/worktrees/*}
      break
    fi
    [[ $dir == */* ]] || { dir=$1; break; }
    dir=${dir%/*}
  done
  case $dir in
    "$HOME") dir='~' ;;
    "$HOME"/*) dir="~/${dir#"$HOME"/}" ;;
  esac
  printf '%s\n' "$dir"
}

# the live sessions' state and context files, for the one pass below, and
# each one's count of running subagents as a named argument, its id the
# name; a dead session's files are removed. Each one's repo, a line apiece
live_files=() subagent_counts=() repo_lines=''
while IFS=$'\x1f' read -r sid pid cwd; do
  state_file=$dir/$sid.json
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    rm -rf "$state_file" "$dir/$sid.context.json" "$dir/$sid.agents"
    continue
  fi
  live_files+=("$state_file")
  [[ -f $dir/$sid.context.json ]] && live_files+=("$dir/$sid.context.json")
  agents=("$dir/$sid.agents"/*)
  subagent_counts+=(--argjson "$sid" "${#agents[@]}")
  [[ -n $cwd ]] && repo_lines+=$sid$'\x1f'$(repo_of "$cwd")$'\n'
done < <(session_pids)
((${#live_files[@]})) || exit 0
# {session id: repo}
repos=$(printf %s "$repo_lines" |
  jq -Rn '[inputs | split("\u001f") | {key: .[0], value: .[1]}] | from_entries')

jq -nc --argjson panes "$panes" --argjson records "$records" --argjson repos "$repos" \
  "${subagent_counts[@]}" '
  # the state files in order, each with its session id from its name, and
  # {session id: context} from the context files among them. The counts are
  # read from $ARGS.named, which holds panes, records and repos too: session
  # ids are UUIDs, so never one of those names
  (reduce inputs as $doc ({states: [], contexts: {}};
     (input_filename | sub(".*/"; "")) as $file
     | if $file | endswith(".context.json")
       then .contexts[$file | rtrimstr(".context.json")] = $doc
       else .states += [{sid: ($file | rtrimstr(".json")), state: $doc}] end)) as $files
  | [$files.states[]
     | $files.contexts[.sid] as $ctx
     | $ARGS.named[.sid] as $subagents
     | $repos[.sid] as $repo
     | .state
     | ($records[.session_id] // {}) as $rec
     | select($rec.spare != true)
     | . + {name: ($rec.name // $ctx.name?), subagents: $subagents, context: $ctx,
            repo: $repo}] as $sessions
  # the one session a title names, by either of its names
  | def titled: .title as $t
      | [$sessions[] | select(any(.name, .context.name?; . == $t)) | .session_id]
      | select(length == 1) | .[0];
  # {pane: session id} of the panes the hooks recorded a session in
  ($sessions | map(select(.tmux_pane) | {key: .tmux_pane, value: .session_id}) | from_entries) as $recorded
  # the names a session goes by, less the default Claude Code gives a
  # background job (its job id), which is no name at all
  | def names($s): [$sessions[] | select(.session_id == $s) | .name, .context.name?]
      | map(select(. != null and . != $records[$s].jobId));
  # the live background job session $s parked its conversation as, else $s:
  # starting a new chat while one works parks the working one, and the pane
  # goes on showing it. A parked job since gone counts as none
  def unparked($s): $records[$s // ""].parkedJobId as $job
      | [$sessions[] | select($job != null and $records[.session_id].jobId == $job) | .session_id][0] // $s;
  # {pane: the session it shows}. A tagged pane shows its tag, unless that
  # session has a name and the title of the pane names another one: an attach
  # client titles its pane with the title of the conversation, which a resumed
  # job shares with the session it came from, so for a job with no name of
  # its own the title cannot tell the two apart. An untagged Claude pane
  # shows the session its title names, else the one the hooks recorded in
  # it, or the job either parked. The tag before the record, since a `claude
  # attach` client runs its own hooks and records its interactive session in
  # the tagged pane too. A
  # tag naming no live session counts as none: /clear in an attached job
  # gives its conversation a new id, and the pane goes on showing it
  ($panes | map(.title as $title | .tag as $tag | {key: .id, value: (
      if any($sessions[]; .session_id == $tag) then
        (names(.tag) as $own
         | if ($own | length) > 0 and ($own | index($title) | not)
           then ((select(.runs_claude) | titled) // .tag) else .tag end)
      else unparked((select(.runs_claude) | titled) // $recorded[.id]) end)})
     | from_entries) as $shows
  | $sessions[]
  | .session_id as $s
  # an interactive client whose pane shows another session is left out: the
  # pane is the other entry now
  | select($records[$s].kind != "interactive" or ($shows[.tmux_pane // ""] // $s) == $s)
  # the first pane showing it, its recorded one first; null when none does
  | .tmux_pane = ([.tmux_pane, $panes[].id] | map(select(. != null and $shows[.] == $s)) | .[0])
  # whether the window of its pane carries @claude_wait: news not yet looked at
  | .unseen = (.tmux_pane as $pane | any($panes[]; .id == $pane and .waiting))' \
  "${live_files[@]}"
