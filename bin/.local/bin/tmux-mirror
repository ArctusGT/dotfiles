#!/usr/bin/env bash
# tmux-mirror drop PANE | show PANE [HOST]: show a pane of the usual tmux, or
# of an ssh-tmux host's, live and read-only in a floating pane of the frame
# (`tmux-frame`), which stays on screen whatever the frame's right pane shows.
#   drop PANE         an Option+drag released over the frame's PANE, other
#                     than its right pane (the frame's M-MouseDragEnd1Pane
#                     runs this): end the usual tmux's drag, and if PANE is a
#                     float, respawn it to show the pane the drag started on,
#                     in the usual tmux or, from an ssh-tmux window, on its
#                     host. Ends whatever the float was running
#   show PANE [HOST]  draw PANE, on HOST if given, until it closes: the bottom
#                     of it, cut to this pane's size. Reads no keys
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
shopt -s extglob # before the functions are read: draw's patterns need it
# claude-sidebar's shared master connection, so a drop is not a login
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2
  -o ServerAliveCountMax=2 -o ControlPath=/tmp/claude-sidebar-%C
  -o ControlMaster=auto -o ControlPersist=60)

# the usual tmux server, from inside the frame's server too
work() { env -u TMUX -u TMUX_PANE tmux "$@"; }

# a pane id where the drag started, which the usual tmux's M-MouseDrag1Pane
# keeps in its window's @drag_src (on HOST, in the window its relay client
# shows); taken, so the drag's end swaps nothing
take_drag_src() { # $1 window, $2 ssh host
  if [[ -z $2 ]]; then
    work display -p -t "$1" '#{@drag_src}' \; set -wu -t "$1" @drag_src
  else
    # ~/.local/bin first: a host's system tmux may be another version
    ssh "${ssh_opts[@]}" "$2" 'PATH=$HOME/.local/bin:$PATH
      w=$(tmux list-clients -f "#{m:tmux*,#{client_termname}}" -F "#{window_id}" | head -1)
      [ -n "$w" ] && tmux display -p -t "$w" "#{@drag_src}" \; set -wu -t "$w" @drag_src' </dev/null 2>/dev/null
  fi
}

drop() { # $1 the frame pane the drag ended over
  local main tty window host src
  read -r main tty < <(tmux list-panes -F '#{@frame_main} #{pane_id} #{pane_tty}' | awk '$1 == 1 {print $2, $3; exit}')
  [[ -n $main ]] || return 0
  IFS=$'\x1f' read -r window host < <(work display -p -c "$tty" '#{window_id}'$'\x1f''#{@ssh_tmux}')
  src=$(take_drag_src "$window" "$host")
  # the release went to another frame pane, so the usual tmux (and through an
  # ssh-tmux window, the host's) still waits for the drag's end and would
  # take the next click as it: send it one, over the right pane's top-left
  # cell. As raw bytes (-H), which the frame's csi-u key encoding leaves alone
  tmux send-keys -t "$main" -H 1b 5b 3c 38 3b 31 3b 31 6d # \e[<8;1;1m
  [[ -n $src && $(tmux display -p -t "$1" '#{pane_floating_flag}') == 1 ]] || return 0
  tmux respawn-pane -k -t "$1" "$self show $src $host"
}

# the capture of pane $1 every 0.2s, each followed by \036, or a bare \036 when
# unchanged, so a closed reader ends it within a tick; ends when the pane does.
# POSIX sh, as it also runs on an ssh-tmux host
capture_loop() {
  printf '%s' "PATH=\$HOME/.local/bin:\$PATH last=
    while out=\$(tmux capture-pane -p -e -t '$1' 2>/dev/null); do
      if [ \"\$out\" = \"\$last\" ]; then printf '\036'; else printf '%s\036' \"\$out\"; last=\$out; fi
      sleep 0.2
    done"
}

# frame $1 at the terminal's size: its last rows with trailing blank lines
# dropped, each cleared to its end; autowrap is off, so a long line is cut
draw() {
  local rows cols lines n i out=$'\e[H'
  read -r rows cols < <(stty size)
  mapfile -t lines <<<"$1"
  n=${#lines[@]}
  while ((n > 0)) && [[ -z ${lines[n - 1]//@($'\e'\[*([0-9;:])m| )/} ]]; do n=$((n - 1)); done
  for ((i = n > rows ? n - rows : 0; i < n; i++)); do
    out+=${lines[i]}$'\e[0m\e[K'
    ((i < n - 1)) && out+=$'\r\n'
  done
  printf '%s\e[J' "$out"
}

show() { # $1 pane, $2 ssh host
  local frame shown="" size last_size=""
  stty -echo 2>/dev/null
  printf '\e[?25l\e[?7l' # no cursor, no autowrap
  while IFS= read -r -u 3 -d $'\036' frame; do
    size=$(stty size)
    [[ -z $frame && $size == "$last_size" ]] && continue
    [[ -n $frame ]] && shown=$frame
    last_size=$size
    draw "$shown"
  done 3< <(if [[ -n $2 ]]; then ssh "${ssh_opts[@]}" "$2" "$(capture_loop "$1")"; else env -u TMUX -u TMUX_PANE sh -c "$(capture_loop "$1")"; fi)
}

case $1 in
  drop) drop "$2" ;;
  show) show "$2" "$3" ;;
  *) "$self" --help >&2; exit 2 ;;
esac
