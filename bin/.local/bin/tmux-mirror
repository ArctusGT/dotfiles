#!/usr/bin/env bash
# tmux-mirror drop | show | wheel: show a pane of the usual
# tmux, or of an ssh-tmux host's, live and read-only in a floating pane of the
# frame (`tmux-frame`), which stays on screen whatever its right pane shows.
#   drop PANE FLOATING
#                     an Option+drag released over the frame's PANE, other
#                     than its right pane (the frame's M-MouseDragEnd1Pane
#                     runs this): end the usual tmux's drag, and if FLOATING
#                     is 1, respawn PANE to show the pane the drag started on,
#                     in the usual tmux or, from an ssh-tmux window, on its
#                     host. Ends whatever the float was running
#   show PANE [HOST]  draw PANE, on HOST if given, until it closes: what it
#                     shows, copy-mode's scrolled view included, the bottom of
#                     it cut to this pane's size. Reads no keys
#   wheel up|down PANE [HOST]
#                     a wheel tick over the float mirroring PANE (the frame's
#                     WheelUpPane/WheelDownPane run this): scroll PANE as the
#                     wheel over it would, in the program if it takes the
#                     mouse, otherwise in copy-mode
[[ $1 == --help ]] && { awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0; }
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
shopt -s extglob # before the functions are read: draw's patterns need it
# claude-sidebar's shared master connection, so a drop is not a login
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=2
  -o ServerAliveCountMax=2 -o ControlPath=/tmp/claude-sidebar-%C
  -o ControlMaster=auto -o ControlPersist=60)

# the usual tmux server, from inside the frame's server too
work() { env -u TMUX -u TMUX_PANE tmux "$@"; }

# a pane id where the drag started, which the usual tmux's M-MouseDrag1Pane
# keeps in its window's @drag_src (on HOST, in the window its relay client
# shows); taken, so the drag's end swaps nothing
take_drag_src() { # $1 window, $2 ssh host
  if [[ -z $2 ]]; then
    work display -p -t "$1" '#{@drag_src}' \; set -wu -t "$1" @drag_src
  else
    # ~/.local/bin first: a host's system tmux may be another version. The
    # relay client is the one whose terminal is a tmux (termname tmux*)
    ssh "${ssh_opts[@]}" "$2" 'PATH=$HOME/.local/bin:$PATH
      w=$(tmux list-clients -f "#{m:tmux*,#{client_termname}}" -F "#{window_id}" | head -1)
      [ -n "$w" ] && tmux display -p -t "$w" "#{@drag_src}" \; set -wu -t "$w" @drag_src' </dev/null 2>/dev/null
  fi
}

drop() { # $1 the frame pane the drag ended over, $2 1 if it is floating
  local right right_tty window host src
  read -r right right_tty < <(tmux list-panes -f '#{@frame_main}' -F '#{pane_id} #{pane_tty}')
  [[ -n $right ]] || return 0
  # the usual tmux's client in the right pane, and the window it shows
  read -r window host < <(work display -p -c "$right_tty" '#{window_id} #{@ssh_tmux}')
  src=$(take_drag_src "$window" "$host")
  # the release went to another frame pane, so the usual tmux (and through an
  # ssh-tmux window, the host's) still waits for the drag's end and would
  # take the next click as it: send it one, over the right pane's top-left
  # cell. As raw bytes (-H), which the frame's csi-u key encoding leaves alone
  tmux send-keys -t "$right" -H 1b 5b 3c 38 3b 31 3b 31 6d # \e[<8;1;1m
  [[ -n $src && $2 == 1 ]] || return 0
  # @mirror tells the frame's wheel bindings which pane the float shows
  tmux respawn-pane -k -t "$1" "$self show $src $host" \; set -p -t "$1" @mirror "$src${host:+ $host}"
}

# run POSIX sh $1 where the usual tmux is: here, or on ssh host $2, with
# ~/.local/bin first, as a host's system tmux may be another version
on_host() {
  local script="PATH=\$HOME/.local/bin:\$PATH; $1"
  if [[ -n $2 ]]; then ssh "${ssh_opts[@]}" "$2" "$script"
  else env -u TMUX -u TMUX_PANE sh -c "$script"; fi
}

# the capture of pane $1 every 0.2s, each followed by \n\036 (so even a blank
# pane's is not empty), or a bare \036 when unchanged, so a closed reader ends
# it within a tick; ends when the pane does. In copy-mode, the view it is
# scrolled to: -M reads copy-mode's copy of the pane, whose view starts
# scroll_position rows up (empty out of copy-mode, so 0).
# POSIX sh, as it also runs on an ssh-tmux host
capture_loop() {
  printf '%s' "last=
    while out=\$(tmux capture-pane -p -e -M -t '$1' -S '#{e|-:0,#{scroll_position}}' \\
        -E '#{e|-:#{e|-:#{pane_height},1},#{scroll_position}}' 2>/dev/null); do
      if [ \"\$out\" = \"\$last\" ]; then printf '\036'; else printf '%s\n\036' \"\$out\"; last=\$out; fi
      sleep 0.2
    done"
}

# frame $1 in $2 rows: its last rows, after dropping trailing lines of only
# spaces and colour codes, each cleared to its end; autowrap is off, so a long
# line is cut
draw() {
  local rows=$2 lines n start out
  mapfile -t lines <<<"$1"
  n=${#lines[@]}
  while ((n > 0)) && [[ -z ${lines[n - 1]//@($'\e'\[*([0-9;:])m| )/} ]]; do n=$((n - 1)); done
  start=$((n > rows ? n - rows : 0))
  printf -v out '%s\e[0m\e[K\r\n' "${lines[@]:start:n-start}"
  printf '\e[H%s\e[J' "${out%$'\r\n'}"
}

# the frames of pane $1, on ssh host $2 if given
frames() { on_host "$(capture_loop "$1")" "$2"; }

show() { # $1 pane, $2 ssh host
  local frame shown="" size last_size=""
  stty -echo 2>/dev/null
  printf '\e[?25l\e[?7l' # no cursor, no autowrap
  while IFS= read -r -u 3 -d $'\036' frame; do
    size=$(stty size)
    [[ -z $frame && $size == "$last_size" ]] && continue
    [[ -n $frame ]] && shown=$frame
    last_size=$size
    draw "$shown" "${size% *}"
  done 3< <(frames "$1" "$2")
}

# one wheel tick, $1 up or down, over pane $2 on ssh host $3 if given, as
# tmux's default bindings take it: in copy-mode, scroll 5 lines, leaving it at
# the bottom; to a program that takes the mouse, a wheel event at the pane's
# centre, encoded as tmux would; otherwise up enters copy-mode, unless the
# pane is on its alternate screen. POSIX sh, as for capture_loop
wheel() {
  on_host "dir=$1 pane=$2"'
    read -r in_mode mouse sgr alt x y <<EOF
$(tmux display -p -t "$pane" "#{pane_in_mode} #{mouse_any_flag} #{mouse_sgr_flag} #{alternate_on} #{e|+:#{e|/:#{pane_width},2},1} #{e|+:#{e|/:#{pane_height},2},1}")
EOF
    send_wheel() {
      button=64; [ "$dir" = down ] && button=65
      if [ "$sgr" = 1 ]; then
        tmux send-keys -t "$pane" -H $(printf "\033[<%d;%d;%dM" $button $x $y | od -An -tx1)
      else
        tmux send-keys -t "$pane" -H 1b 5b 4d $(printf "%x %x %x" $((button + 32)) $((x + 32)) $((y + 32)))
      fi
    }
    if [ "$in_mode" = 1 ]; then tmux send-keys -t "$pane" -X -N 5 "scroll-$dir"
    elif [ "$mouse" = 1 ]; then send_wheel
    elif [ "$dir" = up ] && [ "$alt" != 1 ]; then tmux copy-mode -e -t "$pane"
    fi' "$3" </dev/null
}

case $1 in
  drop) drop "$2" "$3" ;;
  show) show "$2" "$3" ;;
  wheel) wheel "$2" "$3" "$4" ;;
  *) "$self" --help >&2; exit 2 ;;
esac
