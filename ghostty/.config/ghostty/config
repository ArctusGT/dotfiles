# Ghostty on the Mac, loaded before ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty,
# which wins where both set the same option.

# Cmd+arrows and Cmd+Shift+arrows move between and swap tmux panes
# (tmux-sidebar/.tmux-sidebar.conf and tmux/.tmux.conf.local). tmux reads a
# Cmd modifier as Alt, so these send Ctrl+Alt+arrow and Ctrl+Alt+Shift+arrow,
# which tmux binds. They replace Ghostty's line start/end and jump-to-prompt
# defaults.
keybind = super+arrow_left=csi:1;7D
keybind = super+arrow_right=csi:1;7C
keybind = super+arrow_up=csi:1;7A
keybind = super+arrow_down=csi:1;7B
keybind = super+shift+arrow_left=csi:1;8D
keybind = super+shift+arrow_right=csi:1;8C
keybind = super+shift+arrow_up=csi:1;8A
keybind = super+shift+arrow_down=csi:1;8B

# TokyoNight Night, the palette the tmux bar and borders name by number
# (colour0..colour15). The Application Support config must not set its own
# theme, or it wins.
theme = TokyoNight Night
